    "test:unit": "vitest run",
    "test": "vitest"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
