{
  "name": "markdown-viewer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:security": "vitest run src/features/rendering/security/",
    "test:fixtures": "vitest run bidi-golden-fixtures bidi-alignment-precedence",
    "test": "vitest"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.34",
    "katex": "0.16.47",
    "mermaid": "11.4.1",
    "postcss": "8.5.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "9.0.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
