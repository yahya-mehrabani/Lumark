<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="markdown-viewer"
        Arguments=""
        InstallLocation="C:\Program Files\Markdown Viewer\Markdown Viewer">
    </Installer>
    <PackageInformation
        PackageName="Markdown Viewer"
        PackageDisplayName="Markdown Viewer"
        PublisherName="CN=Markdown Viewer"
        PublisherDisplayName="Markdown Viewer"
        Version="0.1.0.0"
        PackageDescription="A fast, cross-platform Markdown Viewer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.markdownviewer.app"
                Description="A fast, cross-platform Markdown Viewer"
                DisplayName="Markdown Viewer"
                ExecutableName="markdown-viewer"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Markdown Viewer</DisplayName>
            <PublisherDisplayName>Markdown Viewer</PublisherDisplayName>
            <Description>A fast, cross-platform Markdown Viewer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="markdown-viewer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
